# History files
.Rhistory
.Rapp.history

# PyCharm files
*.idea/

# data
*data/

# Large geospatial / EO data products.
# GitHub hard-rejects any file over 100 MB, and these routinely run to GB
# (a single EMIT L2A granule is ~1.7 GB). Keep them in the CyVerse data store
# or Box, not in git.
*.nc
*.nc4
*.h5
*.hdf
*.he5
*.zarr/
*.tif
*.tiff
*.img
*.vrt
*.SAFE/

# Exception: small basemaps/figures committed under docs/ are intentional.
# NOTE: gitignore has no trailing-comment support — a comment after a pattern
# becomes part of the pattern. Keep comments on their own line.
!docs/**/*.tif
!docs/**/*.tiff

# Request / tile caches
notebooks/cache/
*.sqlite
*.sqlite3

# Session Data files
.RData
.RDataTmp
*.DS_Store
docs/.DS_Store

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron



# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
